# ============================================================================
# URBANSHIELD — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in the required credentials for your deployment.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. CLIENT-EXPOSED VARIABLES (Prefixed with VITE_ — safe for browser bundle)
# ----------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-supabase-anon-key"

# ----------------------------------------------------------------------------
# 2. SERVER-ONLY VARIABLES (Never exposed to the frontend bundle)
# ----------------------------------------------------------------------------
PORT=3000
NODE_ENV="development"

# HMAC Session Signing Secret (used by server.ts & src/middleware/auth.ts)
SESSION_SECRET="replace-with-a-strong-random-64-char-secret"

# Optional PostgreSQL / PostGIS Database Connection (Cloud SQL / Supabase Postgres)
SQL_HOST=""
SQL_PORT="5432"
SQL_USER=""
SQL_PASSWORD=""
SQL_DATABASE="urbanshield"

# Optional Twilio SMS Gateway (for live OTP & SOS SMS dispatch)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""