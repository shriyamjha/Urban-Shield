# ============================================================================
# URBANSHIELD — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in the credentials for your existing Supabase project.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. SUPABASE POSTGRESQL DATABASE (Choose OPTION A or OPTION B)
# ----------------------------------------------------------------------------
# OPTION A: Single Connection String (RECOMMENDED — copy from Supabase Dashboard)
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Example: postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=""

# OPTION B: Discrete Connection Parameters (Only needed if NOT using DATABASE_URL)
# - SQL_HOST: e.g. "aws-0-[region].pooler.supabase.com" or "db.[project-ref].supabase.co" (MANDATORY if DATABASE_URL unset)
# - SQL_USER: e.g. "postgres.[project-ref]" or "postgres" (MANDATORY if DATABASE_URL unset)
# - SQL_PASSWORD: your Supabase database password (MANDATORY if DATABASE_URL unset)
# - SQL_PORT: optional (defaults to 5432, or 6543 if pooler host)
# - SQL_DATABASE: optional (defaults to "postgres" — the default Supabase DB name)
SQL_HOST=""
SQL_USER=""
SQL_PASSWORD=""
# SQL_PORT=5432
# SQL_DATABASE=postgres

# ----------------------------------------------------------------------------
# 2. CLIENT-EXPOSED SUPABASE CLIENT (Optional for Supabase JS client auth/realtime)
# ----------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-supabase-anon-key"

# ----------------------------------------------------------------------------
# 3. SERVER-ONLY VARIABLES
# ----------------------------------------------------------------------------
PORT=3000
NODE_ENV="development"

# Session Signing Secret (used by server.ts & src/middleware/auth.ts)
SESSION_SECRET="replace-with-a-strong-random-64-char-secret"

# Optional Twilio SMS Gateway (for live OTP & SOS SMS dispatch)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""